# Copy this file to .env and set the key for the provider you want.
# The provider is auto-detected from whichever key is present; force one with
# RAMANUJAN_PROVIDER=gemini|openrouter|opencode|custom (or `ramanujan run -p ...`).

# --- Gemini (free at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (https://openrouter.ai/keys) ---
# OPENROUTER_API_KEY=
# RAMANUJAN_MODEL=deepseek/deepseek-chat-v3.1:free   # pick a model with tool-calling support

# --- OpenCode Zen (https://opencode.ai/zen) ---
# OPENCODE_API_KEY=
# RAMANUJAN_MODEL=grok-code

# --- Any other OpenAI-compatible server (Groq, Together, Ollama, vLLM, ...) ---
# RAMANUJAN_API_KEY=
# RAMANUJAN_BASE_URL=http://localhost:11434/v1
# RAMANUJAN_MODEL=qwen2.5-coder:32b

# --- Per-role model routing (optional) ---
# Judgment-heavy and tool-heavy roles can use different models. Roles without
# an override share the default model above. Example: cheap analyst/critic,
# strong tool-calling engineer.
# RAMANUJAN_MODEL_PLANNER=
# RAMANUJAN_MODEL_ENGINEER=qwen/qwen3-coder   # pick a strong tool-calling model
# RAMANUJAN_MODEL_ANALYST=
# RAMANUJAN_MODEL_CRITIC=
# RAMANUJAN_MODEL_REPORTER=

# --- Tuning ---
# RAMANUJAN_MIN_SECONDS_BETWEEN_LLM_CALLS=6
# RAMANUJAN_MAX_LLM_CALLS_PER_RUN=120
# RAMANUJAN_EMBEDDER=gemini   # semantic knowledge-base retrieval (default: local hashing)
